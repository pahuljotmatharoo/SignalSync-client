       <property name="styleSheet">
        <string notr="true">/* ===== scrollArea_2 &amp; viewport ===== */
QScrollArea#scrollArea_2 {
    border: 1px solid #C0C0C0;   /* subtle outline */
    border-radius: 12px;         /* round the outer border */
    background-color: #ECE5DD;
    padding: 3px;
}


/* ===== Vertical ScrollBar for scrollArea_2 ===== */
QScrollArea#scrollArea_2 QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollArea#scrollArea_2 QScrollBar::handle:vertical {
    background: rgba(0,0,0,0.2);
    min-height: 20px;
    border-radius: 3px;
}
QScrollArea#scrollArea_2 QScrollBar::add-line,
QScrollArea#scrollArea_2 QScrollBar::sub-line,
QScrollArea#scrollArea_2 QScrollBar::add-page,
QScrollArea#scrollArea_2 QScrollBar::sub-page {
    height: 0;
}
</string>
